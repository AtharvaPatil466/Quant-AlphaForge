# Copy to ops/backup.env (gitignored) to override the backup destination.
#
# Options, best to worst:
#   BACKUP_DEST="b2:alphaforge-backups"       # any rclone remote (run `rclone config` first) — true offsite
#   BACKUP_DEST="/Volumes/ExternalDrive/AlphaForgeBackups"   # external disk
#   (unset)                                    # iCloud Drive folder if available, else ~/AlphaForgeBackups
#
# Note: the iCloud default only reaches Apple's servers if your iCloud quota
# has ~4 GB free; otherwise the files sit locally in the CloudDocs folder
# (still a copy, but same-disk). Check quota in System Settings > iCloud.
BACKUP_DEST=""
