<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphaforge.watchdog</string>

    <!-- Runs ops/collector_watchdog.sh every 5 minutes. The script wraps
         collector/health_check.py, logs locally, notifies on CRITICAL, and
         (once ops/watchdog.env has a HEALTHCHECKS_URL) pings the dead-man
         heartbeat. Remove with:
           launchctl bootout gui/$(id -u)/com.alphaforge.watchdog
           rm ~/Library/LaunchAgents/com.alphaforge.watchdog.plist -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/atharva/Quant Projects/Quant Alpha/ops/collector_watchdog.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/atharva/Quant Projects/Quant Alpha/alphaforge-microstructure/logs/watchdog.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/atharva/Quant Projects/Quant Alpha/alphaforge-microstructure/logs/watchdog.launchd.log</string>
</dict>
</plist>
